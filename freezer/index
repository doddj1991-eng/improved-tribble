<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Freezer Inventory</title>

<style>
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 16px;
    background: #f4f4f4;
}

h1 {
    margin-top: 0;
}

.card {
    background: white;
    padding: 12px;
    border-radius: 10px;
    margin-bottom: 12px;
}

input, button {
    width: 100%;
    padding: 10px;
    margin-top: 8px;
    box-sizing: border-box;
    font-size: 16px;
}

button {
    cursor: pointer;
}

.item {
    border-bottom: 1px solid #ddd;
    padding: 10px 0;
}

.small {
    color: #666;
    font-size: 14px;
}

.old {
    color: #b00020;
    font-weight: bold;
}
</style>
</head>

<body>

<h1>Freezer Inventory</h1>

<div class="card">
    <h2>Add Item</h2>

    <input type="text" id="barcode" placeholder="Barcode">
    <button onclick="scanBarcode()">Scan Barcode</button>

    <input type="text" id="name" placeholder="Meal Name">

    <input type="number" id="portions" placeholder="Portions">

    <input type="date" id="date">

    <input type="text" id="notes" placeholder="Notes">

    <button onclick="addItem()">Add To Freezer</button>
</div>

<div class="card">
    <h2>Inventory</h2>

    <input type="text" id="search" placeholder="Search..." oninput="renderItems()">

    <div id="inventory"></div>
</div>

<script>

let items = JSON.parse(localStorage.getItem("freezerItems")) || [];

document.getElementById("date").valueAsDate = new Date();

function saveItems() {
    localStorage.setItem("freezerItems", JSON.stringify(items));
}

function addItem() {

    const barcode = document.getElementById("barcode").value;
    const name = document.getElementById("name").value;
    const portions = parseInt(document.getElementById("portions").value);
    const date = document.getElementById("date").value;
    const notes = document.getElementById("notes").value;

    if (!name || !portions || !date) {
        alert("Please complete all required fields.");
        return;
    }

    items.push({
        id: Date.now(),
        barcode,
        name,
        portions,
        date,
        notes
    });

    saveItems();
    renderItems();

    document.getElementById("barcode").value = "";
    document.getElementById("name").value = "";
    document.getElementById("portions").value = "";
    document.getElementById("notes").value = "";
}

function renderItems() {

    const inventory = document.getElementById("inventory");
    const search = document.getElementById("search").value.toLowerCase();

    inventory.innerHTML = "";

    const sorted = items.sort((a, b) => new Date(a.date) - new Date(b.date));

    sorted.forEach(item => {

        if (!item.name.toLowerCase().includes(search)) {
            return;
        }

        const daysOld = Math.floor(
            (new Date() - new Date(item.date)) / (1000 * 60 * 60 * 24)
        );

        const div = document.createElement("div");
        div.className = "item";

        div.innerHTML = `
            <strong>${item.name}</strong>
            <div class="small">
                Portions: ${item.portions}
            </div>
            <div class="small">
                Frozen: ${item.date}
            </div>
            <div class="small ${daysOld > 90 ? 'old' : ''}">
                ${daysOld} days old
            </div>
            <div class="small">
                ${item.notes || ""}
            </div>

            <button onclick="usePortion(${item.id})">
                Use 1 Portion
            </button>

            <button onclick="deleteItem(${item.id})">
                Delete
            </button>
        `;

        inventory.appendChild(div);
    });
}

function usePortion(id) {

    const item = items.find(i => i.id === id);

    if (!item) return;

    item.portions--;

    if (item.portions <= 0) {
        items = items.filter(i => i.id !== id);
    }

    saveItems();
    renderItems();
}

function deleteItem(id) {

    items = items.filter(i => i.id !== id);

    saveItems();
    renderItems();
}

async function scanBarcode() {

    if (!('BarcodeDetector' in window)) {
        alert("Barcode scanning not supported on this device/browser.");
        return;
    }

    try {

        const stream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: "environment" }
        });

        const video = document.createElement("video");
        video.srcObject = stream;
        video.play();

        const detector = new BarcodeDetector({
            formats: ['ean_13', 'qr_code', 'code_128']
        });

        const interval = setInterval(async () => {

            const barcodes = await detector.detect(video);

            if (barcodes.length > 0) {

                document.getElementById("barcode").value = barcodes[0].rawValue;

                clearInterval(interval);

                stream.getTracks().forEach(track => track.stop());

                alert("Barcode scanned!");
            }

        }, 500);

    } catch (err) {
        alert("Camera access failed.");
    }
}

renderItems();

</script>

</body>
</html>
